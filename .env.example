# Copie ce fichier vers `.env.local` puis colle tes clés.
# Aucune clé n'est obligatoire pour Hyperliquid (perps + spot publics).

# --- IA (bouton « Avis IA », cache 45 min) : optionnel ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Données marché hors HL (optionnel) ---
COINGECKO_API_KEY=

# --- Telegram : bilan 2h + spikes +1.5% + baleines ---
TELEGRAM_BOT_TOKEN=
# Optionnel si tu lies via /start + bouton dans l’app
TELEGRAM_CHAT_ID=

# --- Accès site (UI) — n’arrête PAS le bot ---
# Mot de passe pour Login (haut droite) → débloque Boriaz + Lab.
# OBLIGATOIRE : sans SITE_PASSWORD, Boriaz/Lab restent cachés/inaccessibles.
# Le cron /api/cron continue via CRON_SECRET (exemption middleware).
SITE_PASSWORD=
# Optionnel : sel du cookie portail (sinon CRON_SECRET / SITE_PASSWORD).
# SITE_GATE_SECRET=

# --- Cron Vercel (/api/cron) + cron externe 15 min ---
# Heartbeat : price watch + analyse + getTradeSignals (paper + LIVE Boriaz si armé).
# Tourne en fond même si personne n’est connecté à l’UI.
CRON_SECRET=

# --- LIVE Hyperliquid (Défaut + Boriaz uniquement) ---
# Kill-switch : doit être "true" pour autoriser tout ordre réel.
# Scalp / autres portefeuilles = paper only (LIVE forcé off).
HL_LIVE_ENABLED=false
# Long-only si false. true (défaut code) = shorts autorisés UNIQUEMENT
# continuation D1+H4 deep + conf LIVE ≥90 (pas correction / H4-lead / shallow).
HL_ALLOW_SHORT=true
# Clé de l'AGENT wallet (app.hyperliquid.xyz → API), PAS la seed master.
# À mettre UNIQUEMENT dans Vercel → Settings → Environment Variables (Secret).
# Ne jamais coller ici en prod commitée, ni dans le chat, ni dans le Lab.
# Alias accepté : HL_AGENT_PRIVATE_KEY (même valeur).
HL_AGENT_PRIVATE_KEY=
# OBLIGATOIRE avec un API wallet : adresse MASTER (celle qui a les USDC ~109$).
# PAS l’adresse de l’agent (my_api_boriaz / 0x947c…).
# L’agent signe ; le master détient le solde. Alias : HL_ACCOUNT_ADDRESS
HL_ACCOUNT_ADDRESS=
# true = testnet HL (recommandé avant le mainnet)
HL_LIVE_TESTNET=false
# Caps de sécurité — avec ~110 USDC, garde NOTIONAL ≤ 80 et leverage ≤ 3.
# Plafond de sécurité OPTIONNEL (pas la taille du trade).
# Le live size à 2% de ton equity HL réelle. Ce cap évite juste un notionnel absurde
# si le SL est très serré. Avec ~110$, 150–300 suffit. Tu peux omettre : défaut 500.
HL_MAX_NOTIONAL_USD=500
HL_MAX_LEVERAGE=3
HL_MAX_OPEN_POSITIONS=2

# --- Upstash Redis (paper + journal persistants sur Vercel) ---
# Créer une DB gratuite : https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Labels / intel on-chain hors HL (préparé) ---
# https://platform.arkhamintelligence.com/
ARKHAM_API_KEY=
# https://app.nansen.ai/
NANSEN_API_KEY=

# --- Architecture money guards (AI_COST_CONTROL / RISK) ---
# CRON_SECRET=...          # obligatoire en prod (fail-closed)
AI_ENABLED=true
AI_MIN_SIGNAL_SCORE=70
AI_TIMEOUT_MS=12000
MAX_AI_CALLS_PER_HOUR=60
MAX_AI_CALLS_PER_DAY=500
AI_CIRCUIT_BREAKER_FAILURES=5
