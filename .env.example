# Copie ce fichier vers `.env.local` puis colle tes clés.
# Aucune clé n'est obligatoire pour Hyperliquid (perps + spot publics).

# --- IA (onglet Analyse BTC) : au moins une ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# ou
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Données marché hors HL (optionnel, rate-limit public OK sans clé) ---
COINGECKO_API_KEY=

# --- Alertes Telegram (préparé, branché ensuite) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Labels / intel on-chain hors HL (préparé) ---
# https://platform.arkhamintelligence.com/
ARKHAM_API_KEY=
# https://app.nansen.ai/
NANSEN_API_KEY=
