# Copie vers `.env.local`. Aucun secret réel ici.
# Défaut post-migration : SHADOW — aucun ordre Hyperliquid réel.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=UTC

# --- Modes trading (sûrs par défaut) ---
# shadow | paper | live — JAMAIS live par défaut
TRADING_MODE=shadow
LIVE_TRADING_ENABLED=false
GLOBAL_KILL_SWITCH=true
RECONCILIATION_REQUIRED=true
POSTGRES_REQUIRED_FOR_LIVE=true
ALLOW_TESTNET_LIVE=false

# --- PostgreSQL (source de vérité) ---
# Local docker compose :
DATABASE_URL=postgresql://boriaz:boriaz@127.0.0.1:5432/boriazbot
PG_POOL_MAX=5
# PG_SSL=false
BOT_EVENT_RETENTION_DAYS=30
MARKET_DATA_RETENTION_DAYS=14
DATABASE_RETENTION_DAYS=90

# --- Redis (cache / locks / heartbeats) — pas source de vérité ---
REDIS_URL=redis://127.0.0.1:6379
# Ou Upstash REST (Vercel) — aussi accepté comme Redis durable :
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Market data ---
MARKET_DATA_STALE_SECONDS=10
WEBSOCKET_RECONNECT_BASE_SECONDS=1
WEBSOCKET_RECONNECT_MAX_SECONDS=60
WEBSOCKET_HEARTBEAT_SECONDS=15
MARKET_WORKER_INTERVAL_MS=10000

# --- IA (validation conditionnelle) ---
AI_ENABLED=true
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=2500
AI_MIN_SIGNAL_SCORE=75
AUTO_TRADE_MIN_SIGNAL_SCORE=85
AI_REQUIRED_FOR_ENTRY=false
AI_COOLDOWN_SECONDS=60
MAX_AI_CALLS_PER_HOUR=60
MAX_AI_CALLS_PER_DAY=500
AI_DAILY_BUDGET_USD=10
AI_CIRCUIT_BREAKER_FAILURES=5
AI_CIRCUIT_BREAKER_RESET_SECONDS=300
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Risk (cibles RiskEngine) ---
MAX_RISK_PER_TRADE_PCT=0.25
MAX_DAILY_LOSS_PCT=2.0
MAX_DRAWDOWN_PCT=10
MAX_CONSECUTIVE_LOSSES=5
MAX_OPEN_POSITIONS=2
MAX_SYMBOL_EXPOSURE_PCT=50
MAX_TOTAL_EXPOSURE_PCT=100
MAX_LEVERAGE=3
MAX_ALLOWED_SPREAD_BPS=15
MAX_ALLOWED_SLIPPAGE_BPS=25
MIN_RISK_REWARD_RATIO=2.0
SIGNAL_EXPIRY_SECONDS=120
SIGNAL_COOLDOWN_SECONDS=60

# --- Hyperliquid ---
HYPERLIQUID_NETWORK=mainnet
# HYPERLIQUID_WS_URL=
# HYPERLIQUID_API_URL=
HL_LIVE_ENABLED=false
# Clé AGENT uniquement — JAMAIS en front, JAMAIS en PostgreSQL
HL_AGENT_PRIVATE_KEY=
HL_ACCOUNT_ADDRESS=
HL_LIVE_TESTNET=false
HL_MAX_NOTIONAL_USD=500
HL_MAX_LEVERAGE=3
HL_MAX_OPEN_POSITIONS=2

# --- Accès site / cron ---
SITE_PASSWORD=
# SITE_GATE_SECRET=
CRON_SECRET=

# --- Autres (existants) ---
COINGECKO_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ARKHAM_API_KEY=
NANSEN_API_KEY=
